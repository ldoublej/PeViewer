---
InheritParentConfig: false
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  readability-duplicate-include
WarningsAsErrors: ''
HeaderFilterRegex: '(^|[/\\])(datasource|parse|dependencies|workspace|peviewer|tests)[/\\]'
ExcludeHeaderFilterRegex: '(^|[/\\])(out|build|pestructs)[/\\]|[/\\][^/\\]*_autogen[/\\]'
SystemHeaders: false
FormatStyle: file
